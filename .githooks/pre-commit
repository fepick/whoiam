#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File "$root/scripts/Check-SensitivePaths.ps1" -RepositoryRoot "$root"
elif command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -File "$root/scripts/Check-SensitivePaths.ps1" -RepositoryRoot "$root"
else
  echo 'PowerShell is required for the sensitive path check. Commit stopped.' >&2
  exit 1
fi
