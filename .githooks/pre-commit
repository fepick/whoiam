#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File "$root/scripts/Check-SensitivePaths.ps1" -RepositoryRoot "$root"
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -File "$root/scripts/Check-SensitivePaths.ps1" -RepositoryRoot "$root"
else
  echo 'PowerShell is required for the sensitive path check. Commit stopped.' >&2
  exit 1
fi
cd "$root"
if ! command -v pre-commit >/dev/null 2>&1; then
  echo 'pre-commit is required. Install requirements-dev.txt in the active Python environment. Commit stopped.' >&2
  exit 1
fi
exec pre-commit run --all-files
